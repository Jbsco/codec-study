project Huffman_Audio is
   --  check (default) keeps assertions and run-time checks on; release builds the programs optimized without them.
   type Build_Kind is ("check", "release");
   Build : Build_Kind := external ("BUILD", "check");

   for Source_Dirs use (".");
   case Build is
      when "check" => for Object_Dir use "obj";
      when "release" => for Object_Dir use "obj-release";
   end case;
   for Main use ("audio_huffman.adb", "codec_main.adb", "checksums_test.adb", "corrupt_test.adb", "stream_decode.adb", "float_bits_test.adb", "stream_encode.adb");

   package Compiler is
      case Build is
         when "check" => for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnatwa");
         when "release" => for Default_Switches ("Ada") use ("-O3", "-gnat2022", "-gnatn", "-gnatp", "-gnatwa");
      end case;
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=2");
   end Prove;
end Huffman_Audio;
