cabal-version: 3.0
name:          huffman-audio
version:       0.1.0.0
synopsis:      Parallel lossless audio coders built on Rice and canonical Huffman codes
license:       NONE
build-type:    Simple

common common-options
  default-language: Haskell2010
  ghc-options:
    -O2
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints
    -Wmissing-export-lists
    -Wpartial-fields
    -Werror
  default-extensions:
    BangPatterns
    OverloadedStrings

library
  import: common-options
  hs-source-dirs: src
  exposed-modules:
    Bits
    BlockCodec
    Blocks
    Coding
    Parallel
    Report
    Stream
    Tiers
    Wav
  build-depends:
    base >= 4.14 && < 5,
    bytestring >= 0.10,
    containers >= 0.6,
    deepseq >= 1.4,
    vector >= 0.12

executable huffman-audio
  import: common-options
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    base,
    huffman-audio,
    deepseq,
    vector
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N -A64m"

executable huffman-audio-hybrid
  import: common-options
  main-is: Main.hs
  hs-source-dirs: hybrid
  other-modules: SparkFFI
  build-depends:
    base,
    huffman-audio,
    vector
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N -A64m"
  -- The Ada library is linked by path, as in hadlink; run with LD_LIBRARY_PATH=../ada/lib.
  ld-options:
    -L../ada/lib
    -lblockcodec
